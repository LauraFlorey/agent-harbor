{
  "name": "agent-harbor",
  "private": true,
  "version": "0.1.21",
  "description": "A local-first workspace for running a team of AI agents.",
  "homepage": "https://github.com/LauraFlorey/agent-harbor",
  "repository": {
    "type": "git",
    "url": "https://github.com/LauraFlorey/agent-harbor.git"
  },
  "author": {
    "name": "Laura Florey",
    "email": "52425450+LauraFlorey@users.noreply.github.com"
  },
  "license": "MIT",
  "desktopName": "com.openmausbot.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm test:updater",
    "test:updater": "node --test electron/updater-coordinator.node-test.mjs",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node --check scripts/dev-all.mjs && node --check electron/main.mjs && node --check electron/terminal-launch.mjs && node --check electron/preload.cjs && node --check electron/capabilities.cjs && node --check electron/cua-connection.cjs && node --check electron/cua.mjs && node --check electron/external-url.cjs && node --check electron/speech.mjs && node --check electron/security.cjs && node --check scripts/build-server.mjs && node --check scripts/verify-server-package.mjs && node --check scripts/smoke-desktop-security.mjs && node --check scripts/dev-access.mjs",
    "preview": "vite preview",
    "build:server": "node scripts/build-server.mjs",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm check:server-package && pnpm build:updater",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && electron-builder --linux --x64 --publish never",
    "package:linux:dir": "pnpm package:prepare && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "dev:access": "node scripts/dev-access.mjs",
    "check:server-package": "node scripts/verify-server-package.mjs",
    "lint": "eslint server src electron scripts",
    "test:desktop-security": "electron scripts/smoke-desktop-security.mjs"
  },
  "dependencies": {
    "@trycua/cua-driver": "0.20.0",
    "ajv": "8.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": "3.1.6",
      "@xmldom/xmldom@<0.8.15": "0.8.15"
    }
  }
}
